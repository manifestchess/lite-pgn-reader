{
  "appId": "com.manifestchess.lite",
  "productName": "Manifest Chess Lite",
  "npmRebuild": false,
  "electronDist": "build/electron-mas-dist",
  "artifactName": "manifest-chess-lite-${version}-mas.${ext}",
  "directories": {
    "buildResources": "build",
    "output": "dist/release-mas"
  },
  "files": [
    "dist-electron/**/*",
    "!dist-electron/**/*.map",
    "package.json",
    "!node_modules/**/*",
    "node_modules/chessops/**/*",
    "node_modules/@badrap/result/**/*"
  ],
  "extraResources": [
    {
      "from": "dist/renderer",
      "to": "renderer"
    }
  ],
  "afterPack": "scripts/afterpack-quicklook.mjs",
  "mac": {
    "category": "public.app-category.games",
    "icon": "build/icon.png",
    "extendInfo": {
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Chess Game (PGN)",
          "CFBundleTypeRole": "Editor",
          "LSHandlerRank": "Default",
          "LSItemContentTypes": [
            "com.manifestchess.pgn"
          ]
        }
      ],
      "UTImportedTypeDeclarations": [
        {
          "UTTypeIdentifier": "com.manifestchess.pgn",
          "UTTypeDescription": "Portable Game Notation",
          "UTTypeConformsTo": [
            "public.plain-text"
          ],
          "UTTypeTagSpecification": {
            "public.filename-extension": [
              "pgn"
            ],
            "public.mime-type": [
              "application/vnd.chess-pgn",
              "application/x-chess-pgn"
            ]
          }
        }
      ],
      "NSHumanReadableCopyright": "Copyright © 2026 Ordinary Ventures MB",
      "ITSAppUsesNonExemptEncryption": false,
      "ElectronTeamID": "VN3M9RS6R3"
    }
  },
  "mas": {
    "target": [
      "pkg"
    ],
    "type": "distribution",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mas.plist",
    "entitlementsInherit": "build/entitlements.mas.inherit.plist",
    "provisioningProfile": "build/embedded.provisionprofile",
    "extraResources": [
      {
        "from": "build/PrivacyInfo.xcprivacy",
        "to": "PrivacyInfo.xcprivacy"
      }
    ],
    "signIgnore": [
      "\\.appex(/|$)"
    ]
  },
  "masDev": {
    "target": [
      "dir"
    ],
    "type": "development",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mas.plist",
    "entitlementsInherit": "build/entitlements.mas.inherit.plist",
    "provisioningProfile": "build/embedded-dev.provisionprofile",
    "extraResources": [
      {
        "from": "build/PrivacyInfo.xcprivacy",
        "to": "PrivacyInfo.xcprivacy"
      }
    ],
    "signIgnore": [
      "\\.appex(/|$)"
    ]
  },
  "publish": null
}
