{
  "name": "manifest-chess-pgn-reader",
  "version": "1.0.0",
  "description": "Manifest Chess Lite - a fast, fully offline single-file PGN reader for macOS",
  "license": "GPL-3.0-or-later",
  "author": "Manifest Chess",
  "main": "dist-electron/electron/main.js",
  "private": true,
  "scripts": {
    "postinstall": "patch-package && node scripts/fetch-engines.mjs",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:main": "tsc -p electron/tsconfig.json && node scripts/build-preload.mjs",
    "compile": "npm run build:main && npm run build:renderer",
    "dev": "npm run compile && electron .",
    "dist": "node scripts/build-release.mjs",
    "dist:mas": "node scripts/build-mas.mjs",
    "dist:mas-dev": "node scripts/build-mas.mjs --dev"
  },
  "dependencies": {
    "@heroui/react": "3.0.3",
    "@heroui/styles": "3.0.3",
    "chessground": "9.2.1",
    "chessops": "0.15.0",
    "clsx": "2.1.1",
    "intl-messageformat": "10.7.16",
    "next-themes": "0.4.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.5.0",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.126",
    "@iconify/react": "6.0.2",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.1.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.5.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "29.0.1",
    "patch-package": "8.0.1",
    "postcss": "8.5.26",
    "prettier": "3.5.3",
    "tailwindcss": "4.1.11",
    "tsx": "4.22.4",
    "typescript": "5.6.3",
    "vitest": "4.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manifestchess/lite-pgn-reader.git"
  },
  "homepage": "https://github.com/manifestchess/lite-pgn-reader#readme",
  "bugs": {
    "url": "https://github.com/manifestchess/lite-pgn-reader/issues"
  }
}
